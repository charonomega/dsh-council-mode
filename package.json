{
  "name": "@local/dsh-council-mode",
  "version": "0.2.4",
  "private": false,
  "description": "Council Mode: a WeChat-like multi-agent meeting room for DeepSeek Harness and CLI Worker agents.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "dsh-cliworker-now": ">=0.8.2 <0.9.0"
  },
  "files": [
    "index.js",
    "lib",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "README.md",
    "NOTICE",
    "LICENSE",
    "THIRD_PARTY_LICENSES",
    "docs",
    "CONTRIBUTING.md"
  ],
  "author": "charonomega",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonomega/dsh-council-mode.git"
  },
  "homepage": "https://github.com/charonomega/dsh-council-mode#readme",
  "bugs": {
    "url": "https://github.com/charonomega/dsh-council-mode/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "council",
    "multi-agent"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependenciesMeta": {
    "dsh-cliworker-now": {
      "optional": true
    }
  }
}
